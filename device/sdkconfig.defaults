# ---- target / flash ----
CONFIG_IDF_TARGET="esp32c3"
# ESP32-C3 无 PSRAM：不要打开 SPIRAM 相关选项。
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
# 固定 8 MB 镜像头，便于 idf.py merge-bin 产出可交付的合并镜像。
CONFIG_ESPTOOLPY_HEADER_FLASHSIZE_UPDATE=n

CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"

# ---- console ----
# USB-Serial-JTAG（C3 原生 USB，GPIO18/19）：UART0 的 TX=GPIO21 与本板背光冲突。
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y

# ---- freertos ----
CONFIG_FREERTOS_HZ=1000

# ---- NimBLE ----
# 只做单连接 peripheral：省 RAM，也避免多连接时的缓冲池竞争。
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL=n
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=y
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=y
CONFIG_BT_NIMBLE_ROLE_OBSERVER=n
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BT_NIMBLE_HOST_BASED_PRIVACY=n
CONFIG_BT_NIMBLE_NVS_PERSIST=y

# MTU 247：165 字节音频块单包发送（需 >= 168），余量留给 STATUS / EVENT。
CONFIG_BT_NIMBLE_ATT_PREFERRED_MTU=247

# MSYS 池：一条音频通知占 2 块（ATT 头 + 165 字节载荷），默认 12 块 = 最多 6 条在途。
# 链路一慢就变成"6 块一组"的尖峰，第 7 块起全部 ENOMEM（KI-005 的 1.5–2 块/秒）。
# 24 块 = 12 条在途，给连接事件之间的抖动留一倍余量；代价是 +3 KB RAM。
CONFIG_BT_NIMBLE_MSYS_1_BLOCK_COUNT=24

# ---- 音频 ----
# esp_codec_dev 由组件管理器按 main/idf_component.yml 拉取。
CONFIG_ESP_MAIN_TASK_STACK_SIZE=4096

# ---- 省电 ----
# 取舍与实测口径见 docs/ARCHITECTURE.md 的「功耗与省电」节。这里只写"为什么"。
#
# BLE modem sleep：事件之间关 RF/PHY/BB。这是最大的一项省电来源。
# 不开它时控制器在连接事件之间也保持射频供电，连接态平均电流是开着的数倍。
CONFIG_BT_CTRL_MODEM_SLEEP=y
CONFIG_BT_CTRL_MODEM_SLEEP_MODE_1=y
# 低功耗时钟选主晶振：本板 CONFIG_RTC_CLK_SRC_INT_RC=y，没有外部 32k 晶振的证据。
# 选 32k 而板上没有时，初始化会静默回退到主晶振（IDF 文档明说），日志与配置对不上；
# 直接写主晶振，行为与配置一致。将来确认板上有 32k 再换，能再降一档。
CONFIG_BT_CTRL_LPCLK_SEL_MAIN_XTAL=y
# 发射功率不再固定在 +9 dBm：运行期按 RSSI 三档调（link.c 的 update_tx_power）。
# 这里保留 +9 作为开机默认值，连上之后 5 s 内会被自适应接管。
CONFIG_BT_CTRL_DFT_TX_POWER_LEVEL_P9=y

# DFS：空闲时 CPU 160 -> 80 MHz。**不开 tickless**（按键 10 ms 轮询会把它切碎，
# 且 I2S 常开时持有 APB_FREQ_MAX 锁，本来就进不了 light sleep）。
CONFIG_PM_ENABLE=y
CONFIG_PM_DFS_INIT_AUTO=n
# light sleep 需要 tickless，这里显式关掉，避免以后误开。
CONFIG_FREERTOS_USE_TICKLESS_IDLE=n
