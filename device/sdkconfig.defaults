# ---- target / flash ----
CONFIG_IDF_TARGET="esp32c3"
# ESP32-C3 无 PSRAM：不要打开 SPIRAM 相关选项。
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
# 固定 8 MB 镜像头，便于 idf.py merge-bin 产出可交付的合并镜像。
CONFIG_ESPTOOLPY_HEADER_FLASHSIZE_UPDATE=n

CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"

# ---- console ----
# USB-Serial-JTAG（C3 原生 USB，GPIO18/19）：UART0 的 TX=GPIO21 与本板背光冲突。
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y

# ---- freertos ----
CONFIG_FREERTOS_HZ=1000

# ---- NimBLE ----
# 只做单连接 peripheral：省 RAM，也避免多连接时的缓冲池竞争。
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL=n
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=y
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=y
CONFIG_BT_NIMBLE_ROLE_OBSERVER=n
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BT_NIMBLE_HOST_BASED_PRIVACY=n
CONFIG_BT_NIMBLE_NVS_PERSIST=y

# MTU 247：165 字节音频块单包发送（需 >= 168），余量留给 STATUS / EVENT。
CONFIG_BT_NIMBLE_ATT_PREFERRED_MTU=247

# ---- 音频 ----
# esp_codec_dev 由组件管理器按 main/idf_component.yml 拉取。
CONFIG_ESP_MAIN_TASK_STACK_SIZE=4096
